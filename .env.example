NODE_ENV=development
DATABASE_URL=postgresql://music_video_wizard:music_video_wizard@localhost:5432/music_video_wizard
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

ASSET_STORAGE_DRIVER=local
ASSET_STORAGE_BUCKET=music-video-wizard-dev
ASSET_STORAGE_ENDPOINT=
ASSET_STORAGE_REGION=us-east-1
ASSET_STORAGE_ACCESS_KEY_ID=
ASSET_STORAGE_SECRET_ACCESS_KEY=
ASSET_STORAGE_FORCE_PATH_STYLE=false
ASSET_STORAGE_LOCAL_ROOT=.data/assets
MAX_AUDIO_UPLOAD_BYTES=536870912
JOB_QUEUE_SCHEMA=pgboss
JOB_RETRY_LIMIT=3
JOB_RETRY_DELAY_SECONDS=5
JOB_RETRY_DELAY_MAX_SECONDS=300
JOB_EXPIRE_SECONDS=21600
JOB_HEARTBEAT_SECONDS=30
JOB_WORKER_CONCURRENCY=4
JOB_WORKSPACE_CONCURRENCY=2
JOB_DRAIN_SECRET=
JOB_DRAIN_BATCH_SIZE=2
JOB_EXECUTOR_URL=
JOB_WAKE_TIMEOUT_MS=90000

AUDIO_ANALYSIS_PYTHON=python3
AUDIO_ANALYSIS_FFMPEG=ffmpeg
VIDEO_RENDER_FFMPEG=ffmpeg
AUDIO_TRANSCRIPTION_PROVIDER=none
AUDIO_TRANSCRIPTION_MODEL=gpt-transcribe

TEXT_GENERATION_PROVIDER=none
TEXT_GENERATION_MODEL=gpt-6-sol

IMAGE_GENERATION_PROVIDER=none
VIDEO_GENERATION_PROVIDER=none

RUNWAY_API_SECRET=
RUNWAY_BASE_URL=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
