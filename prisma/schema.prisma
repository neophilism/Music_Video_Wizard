generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum VersionLifecycle {
  DRAFT
  LOCKED
  SUPERSEDED
}

enum DomainVersionKind {
  PROJECT
  SEQUENCE
  SHOT
  CREATIVE_MODULE
  CREATIVE_KIT
  MUSIC_ANALYSIS
  MUSIC_MAP
  CREATIVE_BRIEF
  CONCEPT_SET
  TREATMENT
  ASSET
  TIMELINE
}

enum CreativeModuleKind {
  VISUAL_AESTHETIC
  COLOR_LIGHTING
  CHARACTER
  WARDROBE
  LOCATION_WORLD
  PROP
  CINEMATOGRAPHY_GRAMMAR
  COMPOSITION_GRAMMAR
  MOTION_GRAMMAR
  PERFORMANCE_GRAMMAR
  EDITING_GRAMMAR
  TRANSITION_GRAMMAR
  PACING_CURVE
  NARRATIVE_TEMPLATE
  MOTIF
  IMAGE_PROMPT_MODULE
  NEGATIVE_PROMPT_MODULE
  VIDEO_PROMPT_MODULE
  GENERATION_RECIPE
  TYPOGRAPHY_KIT
  OUTPUT_PRESET
  STORYBOARD_PATTERN
  OTHER
}

enum AssetKind {
  AUDIO_MASTER
  REFERENCE_IMAGE
  STORYBOARD_IMAGE
  GENERATED_IMAGE
  GENERATED_VIDEO
  GRAPHIC
  TITLE_CARD
  RENDER_PREVIEW
  RENDER_MASTER
  OTHER
}

enum AssetStatus {
  PENDING
  READY
  FAILED
  QUARANTINED
}

enum GenerationKind {
  IMAGE
  VIDEO
  ANALYSIS
  TEXT
  RENDER
  OTHER
}

enum GenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum GenerationEventType {
  QUEUED
  STARTED
  PROGRESS
  RETRY_SCHEDULED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DependencyRelation {
  DERIVED_FROM
  REFERENCES
  GENERATED_FROM
  COMPILED_FROM
  RENDERED_FROM
}

enum TimelineKind {
  FIRST_CUT
  WORKING
  ALTERNATE
  EXPORT
}

enum TimelineTrackKind {
  VIDEO
  GRAPHIC
  TITLE
}

enum TimelineItemOrigin {
  AUTOMATIC
  MANUAL
}

enum WizardStepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}

enum MusicMapAnchorKind {
  SECTION
  INTRO
  OUTRO
  BEAT
  BAR
  DROP
  TRANSITION
  VOCAL_PASSAGE
  INSTRUMENTAL_BREAK
  CUSTOM
}

enum MusicMapAnchorSource {
  ANALYSIS
  USER
}

enum MusicMapAnchorDecision {
  PENDING
  ACCEPTED
  REJECTED
}

enum ConceptOptionOrigin {
  GENERATED
  REVISED
  COMBINED
  MANUAL
}

enum ConceptLineageRole {
  REVISION_SOURCE
  COMBINATION_SOURCE
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  emailVerified Boolean  @default(false)
  displayName   String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions                      Session[]
  accounts                      Account[]
  memberships                   WorkspaceMembership[]
  projectVersionsCreated        ProjectVersion[]        @relation("ProjectVersionCreator")
  sequenceVersionsCreated       SequenceVersion[]       @relation("SequenceVersionCreator")
  shotVersionsCreated           ShotVersion[]           @relation("ShotVersionCreator")
  creativeModuleVersionsCreated CreativeModuleVersion[] @relation("CreativeModuleVersionCreator")
  creativeKitVersionsCreated    CreativeKitVersion[]    @relation("CreativeKitVersionCreator")
  musicAnalysisVersionsCreated  MusicAnalysisVersion[]  @relation("MusicAnalysisVersionCreator")
  musicMapVersionsCreated       MusicMapVersion[]       @relation("MusicMapVersionCreator")
  creativeBriefVersionsCreated  CreativeBriefVersion[]  @relation("CreativeBriefVersionCreator")
  conceptSetVersionsCreated      ConceptSetVersion[]      @relation("ConceptSetVersionCreator")
  conceptOptionsCreated          ConceptOption[]          @relation("ConceptOptionCreator")
  treatmentVersionsCreated       TreatmentVersion[]       @relation("TreatmentVersionCreator")
  assetVersionsCreated          AssetVersion[]          @relation("AssetVersionCreator")
  generationJobsRequested       GenerationJob[]         @relation("GenerationJobRequester")
  timelineVersionsCreated       TimelineVersion[]       @relation("TimelineVersionCreator")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     WorkspaceMembership[]
  projects        Project[]
  creativeModules CreativeModule[]
  creativeKits    CreativeKit[]
  assets          Asset[]
  generationJobs  GenerationJob[]
}

model WorkspaceMembership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  title       String
  description String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  versions  ProjectVersion[]
  sequences Sequence[]
  shots     Shot[]
  assets    Asset[]
  timelines Timeline[]
  musicAnalysis MusicAnalysis?
  musicMap      MusicMap?
  creativeBrief CreativeBrief?
  conceptSet    ConceptSet?
  treatment     Treatment?
  generationJobs GenerationJob[]

  @@index([workspaceId, updatedAt])
}

model ProjectVersion {
  id                        String           @id @default(uuid()) @db.Uuid
  projectId                 String           @db.Uuid
  nodeId                    String           @unique @db.Uuid
  versionNumber             Int
  lifecycle                 VersionLifecycle @default(DRAFT)
  title                     String
  description               String?          @db.Text
  aspectRatio               String?
  outputWidth               Int?
  outputHeight              Int?
  frameRate                 Float?
  audioMasterAssetVersionId String?          @db.Uuid
  specification             Json?
  notes                     String?          @db.Text
  createdByUserId           String?          @db.Uuid
  createdAt                 DateTime         @default(now())
  lockedAt                  DateTime?

  project          Project           @relation(fields: [projectId], references: [id])
  node             DomainVersionNode @relation(fields: [nodeId], references: [id])
  createdBy        User?             @relation("ProjectVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  audioMasterAssetVersion AssetVersion? @relation("ProjectVersionAudioMaster", fields: [audioMasterAssetVersionId], references: [id], onDelete: Restrict)
  sequences        ProjectVersionSequence[]
  basisForTimelines TimelineVersion[] @relation("TimelineBasisProjectVersion")
  wizardProgress     WizardProgress?

  @@unique([projectId, versionNumber])
  @@index([projectId, lifecycle])
}


model WizardProgress {
  id               String   @id @default(uuid()) @db.Uuid
  projectVersionId String   @unique @db.Uuid
  currentStepKey   String   @default("project-setup")
  revision         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projectVersion ProjectVersion  @relation(fields: [projectVersionId], references: [id], onDelete: Cascade)
  steps          WizardStepState[]

  @@index([updatedAt])
}

model WizardStepState {
  id                 String           @id @default(uuid()) @db.Uuid
  wizardProgressId   String           @db.Uuid
  stepKey            String
  ordinal            Int
  status             WizardStepStatus @default(NOT_STARTED)
  payload            Json?
  payloadFingerprint String?
  contentRevision    Int              @default(0)
  lastSavedAt        DateTime?
  completedAt        DateTime?
  lockedAt           DateTime?
  needsReviewAt      DateTime?
  reviewReason       String?          @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  wizardProgress WizardProgress @relation(fields: [wizardProgressId], references: [id], onDelete: Cascade)

  @@unique([wizardProgressId, stepKey])
  @@unique([wizardProgressId, ordinal])
  @@index([wizardProgressId, status])
}

model Sequence {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  createdAt DateTime @default(now())

  project  Project           @relation(fields: [projectId], references: [id])
  versions SequenceVersion[]

  @@index([projectId])
}

model SequenceVersion {
  id              String           @id @default(uuid()) @db.Uuid
  sequenceId      String           @db.Uuid
  nodeId          String           @unique @db.Uuid
  versionNumber   Int
  lifecycle       VersionLifecycle @default(DRAFT)
  title           String
  summary         String?          @db.Text
  purpose         String?          @db.Text
  musicStartMs    Int?
  musicEndMs      Int?
  structuredSpec  Json?
  createdByUserId String?          @db.Uuid
  createdAt       DateTime         @default(now())
  lockedAt        DateTime?

  sequence   Sequence          @relation(fields: [sequenceId], references: [id])
  node       DomainVersionNode @relation(fields: [nodeId], references: [id])
  createdBy  User?             @relation("SequenceVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  projectLinks ProjectVersionSequence[]
  shotLinks    SequenceVersionShot[]

  @@unique([sequenceId, versionNumber])
  @@index([sequenceId, lifecycle])
}

model ProjectVersionSequence {
  id                String @id @default(uuid()) @db.Uuid
  projectVersionId  String @db.Uuid
  sequenceVersionId String @db.Uuid
  position          Int

  projectVersion  ProjectVersion  @relation(fields: [projectVersionId], references: [id], onDelete: Cascade)
  sequenceVersion SequenceVersion @relation(fields: [sequenceVersionId], references: [id], onDelete: Restrict)

  @@unique([projectVersionId, position])
  @@unique([projectVersionId, sequenceVersionId])
  @@index([sequenceVersionId])
}

model Shot {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  createdAt DateTime @default(now())

  project  Project       @relation(fields: [projectId], references: [id])
  versions ShotVersion[]

  @@index([projectId])
}

model ShotVersion {
  id                    String           @id @default(uuid()) @db.Uuid
  shotId                String           @db.Uuid
  nodeId                String           @unique @db.Uuid
  versionNumber         Int
  lifecycle             VersionLifecycle @default(DRAFT)
  label                 String?
  plannedStartMs        Int?
  plannedEndMs          Int?
  dramaticPurpose       String?          @db.Text
  subject               String?          @db.Text
  locationDescription   String?          @db.Text
  action                String?          @db.Text
  composition           String?          @db.Text
  framing               String?          @db.Text
  cameraAngle           String?          @db.Text
  lens                  String?          @db.Text
  lighting              String?          @db.Text
  colorTreatment        String?          @db.Text
  cameraMotion          String?          @db.Text
  subjectMotion         String?          @db.Text
  continuityNotes       String?          @db.Text
  wardrobeNotes         String?          @db.Text
  propsNotes            String?          @db.Text
  transitionIn          String?          @db.Text
  transitionOut         String?          @db.Text
  imageInstructions     String?          @db.Text
  videoInstructions     String?          @db.Text
  negativeInstructions  String?          @db.Text
  generationHandlesMs   Int?
  structuredSpec        Json?
  createdByUserId       String?          @db.Uuid
  createdAt             DateTime         @default(now())
  lockedAt              DateTime?

  shot          Shot              @relation(fields: [shotId], references: [id])
  node          DomainVersionNode @relation(fields: [nodeId], references: [id])
  createdBy     User?             @relation("ShotVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  sequenceLinks SequenceVersionShot[]
  timelineItems TimelineItem[]

  @@unique([shotId, versionNumber])
  @@index([shotId, lifecycle])
}

model SequenceVersionShot {
  id                String @id @default(uuid()) @db.Uuid
  sequenceVersionId String @db.Uuid
  shotVersionId     String @db.Uuid
  position          Int

  sequenceVersion SequenceVersion @relation(fields: [sequenceVersionId], references: [id], onDelete: Cascade)
  shotVersion     ShotVersion     @relation(fields: [shotVersionId], references: [id], onDelete: Restrict)

  @@unique([sequenceVersionId, position])
  @@unique([sequenceVersionId, shotVersionId])
  @@index([shotVersionId])
}

model CreativeModule {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @db.Uuid
  kind        CreativeModuleKind
  name        String
  description String?            @db.Text
  tags        String[]           @default([])
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace Workspace               @relation(fields: [workspaceId], references: [id])
  versions  CreativeModuleVersion[]

  @@index([workspaceId, kind])
  @@index([workspaceId, updatedAt])
}

model CreativeModuleVersion {
  id                    String           @id @default(uuid()) @db.Uuid
  creativeModuleId      String           @db.Uuid
  nodeId                String           @unique @db.Uuid
  versionNumber         Int
  lifecycle             VersionLifecycle @default(DRAFT)
  definition            Json
  positivePrompt        String?          @db.Text
  negativePrompt        String?          @db.Text
  notes                 String?          @db.Text
  createdByUserId       String?          @db.Uuid
  createdAt             DateTime         @default(now())
  lockedAt              DateTime?

  creativeModule CreativeModule     @relation(fields: [creativeModuleId], references: [id])
  node           DomainVersionNode  @relation(fields: [nodeId], references: [id])
  createdBy      User?              @relation("CreativeModuleVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  references     CreativeModuleReference[]
  bindings       CreativeBinding[]
  kitItems       CreativeKitItem[]

  @@unique([creativeModuleId, versionNumber])
  @@index([creativeModuleId, lifecycle])
}

model CreativeModuleReference {
  id                      String @id @default(uuid()) @db.Uuid
  creativeModuleVersionId String @db.Uuid
  assetVersionId          String @db.Uuid
  role                    String
  position                Int    @default(0)

  creativeModuleVersion CreativeModuleVersion @relation(fields: [creativeModuleVersionId], references: [id], onDelete: Cascade)
  assetVersion          AssetVersion          @relation(fields: [assetVersionId], references: [id], onDelete: Restrict)

  @@unique([creativeModuleVersionId, role, position])
  @@index([assetVersionId])
}

model CreativeBinding {
  id                      String   @id @default(uuid()) @db.Uuid
  scopeNodeId             String   @db.Uuid
  creativeModuleVersionId String   @db.Uuid
  slot                    String
  createdAt               DateTime @default(now())

  scope                 DomainVersionNode     @relation("CreativeBindingScope", fields: [scopeNodeId], references: [id], onDelete: Cascade)
  creativeModuleVersion CreativeModuleVersion @relation(fields: [creativeModuleVersionId], references: [id], onDelete: Restrict)

  @@unique([scopeNodeId, slot])
  @@index([creativeModuleVersionId])
}


model CreativeKit {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String
  description String?   @db.Text
  tags        String[]  @default([])
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id])
  versions  CreativeKitVersion[]

  @@index([workspaceId, updatedAt])
}

model CreativeKitVersion {
  id              String           @id @default(uuid()) @db.Uuid
  creativeKitId   String           @db.Uuid
  nodeId          String           @unique @db.Uuid
  versionNumber   Int
  lifecycle       VersionLifecycle @default(DRAFT)
  notes           String?          @db.Text
  createdByUserId String?          @db.Uuid
  createdAt       DateTime         @default(now())
  lockedAt        DateTime?

  creativeKit CreativeKit       @relation(fields: [creativeKitId], references: [id])
  node        DomainVersionNode @relation(fields: [nodeId], references: [id])
  createdBy   User?             @relation("CreativeKitVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items       CreativeKitItem[]

  @@unique([creativeKitId, versionNumber])
  @@index([creativeKitId, lifecycle])
}

model CreativeKitItem {
  id                      String @id @default(uuid()) @db.Uuid
  creativeKitVersionId    String @db.Uuid
  creativeModuleVersionId String @db.Uuid
  slot                    String
  position                Int    @default(0)

  creativeKitVersion    CreativeKitVersion    @relation(fields: [creativeKitVersionId], references: [id], onDelete: Cascade)
  creativeModuleVersion CreativeModuleVersion @relation(fields: [creativeModuleVersionId], references: [id], onDelete: Restrict)

  @@unique([creativeKitVersionId, slot])
  @@unique([creativeKitVersionId, position])
  @@index([creativeModuleVersionId])
}

model Asset {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String?   @db.Uuid
  kind        AssetKind
  name        String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  versions  AssetVersion[]

  @@index([workspaceId, kind])
  @@index([projectId])
}

model AssetVersion {
  id              String      @id @default(uuid()) @db.Uuid
  assetId         String      @db.Uuid
  nodeId          String      @unique @db.Uuid
  versionNumber   Int
  status          AssetStatus @default(PENDING)
  storageKey      String      @unique
  contentType     String
  byteSize        BigInt?
  checksumSha256  String?
  width           Int?
  height          Int?
  durationMs      Int?
  frameRate       Float?
  metadata        Json?
  createdByUserId String?     @db.Uuid
  createdAt       DateTime    @default(now())
  readyAt         DateTime?

  asset      Asset             @relation(fields: [assetId], references: [id])
  node       DomainVersionNode @relation(fields: [nodeId], references: [id])
  createdBy  User?             @relation("AssetVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  audioMasterForProjectVersions  ProjectVersion[]          @relation("ProjectVersionAudioMaster")
  audioMasterForTimelineVersions TimelineVersion[]         @relation("TimelineVersionAudioMaster")
  creativeModuleReferences       CreativeModuleReference[]
  musicAnalysisVersions          MusicAnalysisVersion[]
  timelineItems                  TimelineItem[]

  @@unique([assetId, versionNumber])
  @@index([assetId, status])
  @@index([checksumSha256])
}


model MusicAnalysis {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions MusicAnalysisVersion[]
}

model MusicAnalysisVersion {
  id                    String           @id @default(uuid()) @db.Uuid
  musicAnalysisId       String           @db.Uuid
  nodeId                String           @unique @db.Uuid
  versionNumber         Int
  lifecycle             VersionLifecycle @default(LOCKED)
  audioAssetVersionId   String           @db.Uuid
  generationJobId       String?          @unique @db.Uuid
  engineKey             String
  engineVersion         String
  transcriptionProvider String?
  transcriptionModel    String?
  durationMs            Int
  result                Json
  createdByUserId       String?          @db.Uuid
  createdAt             DateTime         @default(now())
  lockedAt              DateTime         @default(now())

  musicAnalysis     MusicAnalysis     @relation(fields: [musicAnalysisId], references: [id], onDelete: Cascade)
  node              DomainVersionNode @relation(fields: [nodeId], references: [id])
  audioAssetVersion AssetVersion      @relation(fields: [audioAssetVersionId], references: [id], onDelete: Restrict)
  generationJob     GenerationJob?    @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  createdBy         User?             @relation("MusicAnalysisVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  musicMapVersions MusicMapVersion[]

  @@unique([musicAnalysisId, versionNumber])
  @@index([audioAssetVersionId, createdAt])
  @@index([musicAnalysisId, createdAt])
}


model MusicMap {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions MusicMapVersion[]
}

model MusicMapVersion {
  id                      String           @id @default(uuid()) @db.Uuid
  musicMapId              String           @db.Uuid
  nodeId                  String           @unique @db.Uuid
  versionNumber           Int
  lifecycle               VersionLifecycle @default(DRAFT)
  sourceAnalysisVersionId String           @db.Uuid
  revision                Int              @default(0)
  tempoBpm                Float?
  meterNumerator          Int              @default(4)
  meterDenominator        Int              @default(4)
  beatOffsetMs            Int              @default(0)
  barPhase                Int              @default(0)
  beatGridSource          String           @default("analysis")
  beatGridMs              Json
  barGridMs               Json
  durationMs              Int
  notes                   String?          @db.Text
  createdByUserId         String?          @db.Uuid
  createdAt               DateTime         @default(now())
  lockedAt                DateTime?

  musicMap              MusicMap             @relation(fields: [musicMapId], references: [id], onDelete: Cascade)
  node                  DomainVersionNode    @relation(fields: [nodeId], references: [id])
  sourceAnalysisVersion MusicAnalysisVersion @relation(fields: [sourceAnalysisVersionId], references: [id], onDelete: Restrict)
  createdBy             User?                @relation("MusicMapVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  anchors               MusicMapAnchor[]
  creativeBriefVersions CreativeBriefVersion[]

  @@unique([musicMapId, versionNumber])
  @@index([musicMapId, lifecycle])
  @@index([sourceAnalysisVersionId])
}

model MusicMapAnchor {
  id                String                 @id @default(uuid()) @db.Uuid
  musicMapVersionId String                 @db.Uuid
  sourceKey         String?
  kind              MusicMapAnchorKind
  source            MusicMapAnchorSource
  decision          MusicMapAnchorDecision @default(PENDING)
  label             String
  startMs           Int
  endMs             Int?
  sourceStartMs     Int?
  sourceEndMs       Int?
  sourceConfidence  Float?
  position          Int
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  musicMapVersion MusicMapVersion @relation(fields: [musicMapVersionId], references: [id], onDelete: Cascade)

  @@unique([musicMapVersionId, sourceKey])
  @@unique([musicMapVersionId, position])
  @@index([musicMapVersionId, kind, decision])
  @@index([musicMapVersionId, startMs])
}


model CreativeBrief {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions CreativeBriefVersion[]
}

model CreativeBriefVersion {
  id                      String           @id @default(uuid()) @db.Uuid
  creativeBriefId         String           @db.Uuid
  nodeId                  String           @unique @db.Uuid
  versionNumber           Int
  lifecycle               VersionLifecycle @default(DRAFT)
  sourceMusicMapVersionId String           @db.Uuid
  revision                Int              @default(0)
  brief                   Json
  createdByUserId         String?          @db.Uuid
  createdAt               DateTime         @default(now())
  lockedAt                DateTime?

  creativeBrief         CreativeBrief   @relation(fields: [creativeBriefId], references: [id], onDelete: Cascade)
  node                  DomainVersionNode @relation(fields: [nodeId], references: [id])
  sourceMusicMapVersion MusicMapVersion  @relation(fields: [sourceMusicMapVersionId], references: [id], onDelete: Restrict)
  createdBy             User?            @relation("CreativeBriefVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  conceptSetVersions     ConceptSetVersion[]

  @@unique([creativeBriefId, versionNumber])
  @@index([creativeBriefId, lifecycle])
  @@index([sourceMusicMapVersionId])
}


model ConceptSet {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions ConceptSetVersion[]
}

model ConceptSetVersion {
  id                           String           @id @default(uuid()) @db.Uuid
  conceptSetId                 String           @db.Uuid
  nodeId                       String           @unique @db.Uuid
  versionNumber                Int
  lifecycle                    VersionLifecycle @default(DRAFT)
  sourceCreativeBriefVersionId String           @db.Uuid
  revision                     Int              @default(0)
  selectedConceptId            String?          @unique @db.Uuid
  createdByUserId              String?          @db.Uuid
  createdAt                    DateTime         @default(now())
  lockedAt                     DateTime?

  conceptSet                 ConceptSet           @relation(fields: [conceptSetId], references: [id], onDelete: Cascade)
  node                       DomainVersionNode    @relation(fields: [nodeId], references: [id])
  sourceCreativeBriefVersion CreativeBriefVersion @relation(fields: [sourceCreativeBriefVersionId], references: [id], onDelete: Restrict)
  selectedConcept            ConceptOption?       @relation("SelectedConcept", fields: [selectedConceptId], references: [id], onDelete: SetNull)
  createdBy                  User?                @relation("ConceptSetVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  options                    ConceptOption[]       @relation("ConceptOptions")
  treatmentVersions          TreatmentVersion[]

  @@unique([conceptSetId, versionNumber])
  @@index([conceptSetId, lifecycle])
  @@index([sourceCreativeBriefVersionId])
}

model ConceptOption {
  id                  String              @id @default(uuid()) @db.Uuid
  conceptSetVersionId String              @db.Uuid
  origin              ConceptOptionOrigin
  position            Int
  content             Json
  generationJobId     String?             @db.Uuid
  revisionInstruction String?             @db.Text
  createdByUserId     String?             @db.Uuid
  createdAt           DateTime            @default(now())

  conceptSetVersion ConceptSetVersion   @relation("ConceptOptions", fields: [conceptSetVersionId], references: [id], onDelete: Cascade)
  selectedBy        ConceptSetVersion?  @relation("SelectedConcept")
  generationJob     GenerationJob?      @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  createdBy         User?               @relation("ConceptOptionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  parentLinks       ConceptOptionLineage[] @relation("ConceptChild")
  childLinks        ConceptOptionLineage[] @relation("ConceptParent")
  treatmentVersions TreatmentVersion[]     @relation("TreatmentSourceConcept")

  @@unique([conceptSetVersionId, position])
  @@index([conceptSetVersionId, origin])
  @@index([generationJobId])
}

model ConceptOptionLineage {
  id              String             @id @default(uuid()) @db.Uuid
  childConceptId  String             @db.Uuid
  parentConceptId String             @db.Uuid
  role            ConceptLineageRole
  position        Int                @default(0)
  createdAt       DateTime           @default(now())

  child  ConceptOption @relation("ConceptChild", fields: [childConceptId], references: [id], onDelete: Cascade)
  parent ConceptOption @relation("ConceptParent", fields: [parentConceptId], references: [id], onDelete: Cascade)

  @@unique([childConceptId, parentConceptId, role])
  @@index([parentConceptId])
}

model Treatment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions TreatmentVersion[]
}

model TreatmentVersion {
  id                        String           @id @default(uuid()) @db.Uuid
  treatmentId               String           @db.Uuid
  nodeId                    String           @unique @db.Uuid
  versionNumber             Int
  lifecycle                 VersionLifecycle @default(DRAFT)
  sourceConceptSetVersionId String           @db.Uuid
  sourceConceptId           String           @db.Uuid
  revision                  Int              @default(0)
  document                  Json
  generationJobId           String?          @unique @db.Uuid
  createdByUserId           String?          @db.Uuid
  createdAt                 DateTime         @default(now())
  lockedAt                  DateTime?

  treatment               Treatment         @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  node                    DomainVersionNode @relation(fields: [nodeId], references: [id])
  sourceConceptSetVersion ConceptSetVersion @relation(fields: [sourceConceptSetVersionId], references: [id], onDelete: Restrict)
  sourceConcept           ConceptOption     @relation("TreatmentSourceConcept", fields: [sourceConceptId], references: [id], onDelete: Restrict)
  generationJob           GenerationJob?    @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  createdBy               User?             @relation("TreatmentVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([treatmentId, versionNumber])
  @@index([treatmentId, lifecycle])
  @@index([sourceConceptSetVersionId])
  @@index([sourceConceptId])
}

model GenerationJob {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @db.Uuid
  projectId         String?          @db.Uuid
  kind              GenerationKind
  status            GenerationStatus @default(QUEUED)
  providerKey       String
  modelKey          String?
  requestSnapshot   Json
  responseMetadata  Json?
  errorMessage      String?          @db.Text
  attemptCount      Int              @default(0)
  maxAttempts       Int              @default(4)
  progressPercent   Int              @default(0)
  progressMessage   String?
  requestedByUserId String?          @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?
  cancelRequestedAt DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requestedBy User?     @relation("GenerationJobRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  inputs      GenerationInput[]
  outputs     GenerationOutput[]
  events      GenerationJobEvent[]
  musicAnalysisVersion MusicAnalysisVersion?
  conceptOptions       ConceptOption[]
  treatmentVersion     TreatmentVersion?

  @@index([workspaceId, createdAt])
  @@index([projectId, status])
  @@index([status, createdAt])
}

model GenerationJobEvent {
  id              String              @id @default(uuid()) @db.Uuid
  jobId           String              @db.Uuid
  type            GenerationEventType
  attempt         Int?
  progressPercent Int?
  message         String?             @db.Text
  metadata        Json?
  createdAt       DateTime            @default(now())

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([type, createdAt])
}

model GenerationInput {
  id         String @id @default(uuid()) @db.Uuid
  jobId      String @db.Uuid
  nodeId     String @db.Uuid
  role       String
  position   Int    @default(0)

  job  GenerationJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  node DomainVersionNode @relation("GenerationInputNode", fields: [nodeId], references: [id], onDelete: Restrict)

  @@unique([jobId, role, position])
  @@index([nodeId])
}

model GenerationOutput {
  id       String @id @default(uuid()) @db.Uuid
  jobId    String @db.Uuid
  nodeId   String @db.Uuid
  role     String
  position Int    @default(0)

  job  GenerationJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  node DomainVersionNode @relation("GenerationOutputNode", fields: [nodeId], references: [id], onDelete: Restrict)

  @@unique([jobId, role, position])
  @@index([nodeId])
}

model Timeline {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @db.Uuid
  kind      TimelineKind
  name      String
  createdAt DateTime     @default(now())

  project  Project           @relation(fields: [projectId], references: [id])
  versions TimelineVersion[]

  @@index([projectId, kind])
}

model TimelineVersion {
  id                        String           @id @default(uuid()) @db.Uuid
  timelineId                String           @db.Uuid
  nodeId                    String           @unique @db.Uuid
  versionNumber             Int
  lifecycle                 VersionLifecycle @default(DRAFT)
  basisProjectVersionId     String           @db.Uuid
  audioMasterAssetVersionId String           @db.Uuid
  parentTimelineVersionId   String?          @db.Uuid
  compiledAutomatically     Boolean          @default(false)
  notes                     String?          @db.Text
  createdByUserId           String?          @db.Uuid
  createdAt                 DateTime         @default(now())
  lockedAt                  DateTime?

  timeline               Timeline          @relation(fields: [timelineId], references: [id])
  node                   DomainVersionNode @relation(fields: [nodeId], references: [id])
  basisProjectVersion    ProjectVersion    @relation("TimelineBasisProjectVersion", fields: [basisProjectVersionId], references: [id], onDelete: Restrict)
  audioMasterAssetVersion AssetVersion     @relation("TimelineVersionAudioMaster", fields: [audioMasterAssetVersionId], references: [id], onDelete: Restrict)
  createdBy              User?             @relation("TimelineVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  parent                 TimelineVersion?  @relation("TimelineVersionParent", fields: [parentTimelineVersionId], references: [id], onDelete: SetNull)
  children               TimelineVersion[] @relation("TimelineVersionParent")
  items                  TimelineItem[]
  transitions            TimelineTransition[]

  @@unique([timelineId, versionNumber])
  @@index([timelineId, lifecycle])
  @@index([basisProjectVersionId])
  @@index([parentTimelineVersionId])
}

model TimelineItem {
  id                String             @id @default(uuid()) @db.Uuid
  timelineVersionId String             @db.Uuid
  trackKind         TimelineTrackKind
  trackIndex        Int                @default(0)
  position          Int
  origin            TimelineItemOrigin @default(AUTOMATIC)
  shotVersionId     String?            @db.Uuid
  assetVersionId    String?            @db.Uuid
  timelineStartMs   Int
  timelineEndMs     Int
  sourceStartMs     Int                @default(0)
  sourceEndMs       Int?
  manualOverride    Boolean            @default(false)
  parameters        Json?

  timelineVersion TimelineVersion @relation(fields: [timelineVersionId], references: [id], onDelete: Cascade)
  shotVersion     ShotVersion?    @relation(fields: [shotVersionId], references: [id], onDelete: Restrict)
  assetVersion    AssetVersion?   @relation(fields: [assetVersionId], references: [id], onDelete: Restrict)
  transitionsFrom TimelineTransition[] @relation("TransitionFromItem")
  transitionsTo   TimelineTransition[] @relation("TransitionToItem")

  @@unique([timelineVersionId, trackKind, trackIndex, position])
  @@index([timelineVersionId, timelineStartMs])
  @@index([shotVersionId])
  @@index([assetVersionId])
}

model TimelineTransition {
  id                String @id @default(uuid()) @db.Uuid
  timelineVersionId String @db.Uuid
  fromItemId        String @db.Uuid
  toItemId          String @db.Uuid
  kind              String
  durationMs        Int
  parameters        Json?

  timelineVersion TimelineVersion @relation(fields: [timelineVersionId], references: [id], onDelete: Cascade)
  fromItem        TimelineItem    @relation("TransitionFromItem", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItem          TimelineItem    @relation("TransitionToItem", fields: [toItemId], references: [id], onDelete: Cascade)

  @@unique([timelineVersionId, fromItemId, toItemId])
  @@index([fromItemId])
  @@index([toItemId])
}

model DomainVersionNode {
  id          String            @id @default(uuid()) @db.Uuid
  kind        DomainVersionKind
  fingerprint String?
  createdAt   DateTime          @default(now())

  projectVersion        ProjectVersion?
  sequenceVersion       SequenceVersion?
  shotVersion           ShotVersion?
  creativeModuleVersion CreativeModuleVersion?
  creativeKitVersion    CreativeKitVersion?
  musicAnalysisVersion  MusicAnalysisVersion?
  musicMapVersion       MusicMapVersion?
  creativeBriefVersion  CreativeBriefVersion?
  conceptSetVersion     ConceptSetVersion?
  treatmentVersion      TreatmentVersion?
  assetVersion          AssetVersion?
  timelineVersion       TimelineVersion?

  upstreamEdges   DependencyEdge[] @relation("DependencyUpstream")
  downstreamEdges DependencyEdge[] @relation("DependencyDownstream")
  creativeBindings CreativeBinding[] @relation("CreativeBindingScope")
  generationInputs GenerationInput[] @relation("GenerationInputNode")
  generationOutputs GenerationOutput[] @relation("GenerationOutputNode")

  @@index([kind, createdAt])
  @@index([fingerprint])
}

model DependencyEdge {
  id               String             @id @default(uuid()) @db.Uuid
  upstreamNodeId   String             @db.Uuid
  downstreamNodeId String             @db.Uuid
  relation         DependencyRelation
  reason           String?            @db.Text
  createdAt        DateTime           @default(now())

  upstream   DomainVersionNode @relation("DependencyUpstream", fields: [upstreamNodeId], references: [id], onDelete: Cascade)
  downstream DomainVersionNode @relation("DependencyDownstream", fields: [downstreamNodeId], references: [id], onDelete: Cascade)

  @@unique([upstreamNodeId, downstreamNodeId, relation])
  @@index([downstreamNodeId])
}
